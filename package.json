{
  "name": "northstar",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @northstar/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @northstar/underwriting --filter @northstar/core --filter @northstar/integrations test",
    "db:migrate": "pnpm --filter @northstar/db migrate",
    "db:seed": "pnpm --filter @northstar/db seed",
    "dev": "pnpm --filter @northstar/web dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
