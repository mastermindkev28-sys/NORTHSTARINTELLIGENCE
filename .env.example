# ---------------------------------------------------------------------------
# Northstar Intelligence — environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres (local dev: `pnpm db:local` starts one on port 54329)
DATABASE_URL=postgres://northstar:northstar@localhost:54329/northstar
# Role used by the application at runtime (RLS enforced; no BYPASSRLS).
DATABASE_APP_ROLE=northstar_app

# Anthropic Claude API (AI qualification, extraction). If unset, the agents
# package uses the deterministic mock model and labels outputs accordingly.
ANTHROPIC_API_KEY=
NORTHSTAR_LLM_MODEL=claude-opus-5-5

# Property data providers (optional; mock provider is used when unset)
ATTOM_API_KEY=
RENTCAST_API_KEY=

# Messaging (Twilio). Outbound messaging is disabled when unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Webhook signing secret for inbound lead intake (HMAC-SHA256)
LEAD_WEBHOOK_SIGNING_SECRET=
