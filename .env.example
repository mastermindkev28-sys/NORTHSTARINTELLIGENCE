# ---- Database ---------------------------------------------------------------
# Application connection: a LOGIN role that is a member of northstar_app (never the table owner).
DATABASE_URL=postgres://northstar_web:devpassword@localhost:5432/northstar_dev
# Owner connection used only by migrations (pnpm db:migrate). Not needed by the running app.
DATABASE_OWNER_URL=postgres://postgres@localhost:5432/northstar_dev
# Local/CI only: lets db:migrate create/update the app login role.
APP_DB_ROLE=northstar_web
APP_DB_PASSWORD=devpassword

# ---- Property data ----------------------------------------------------------
# mock (labelled demo data) | rentcast | realie (planned)
PROPERTY_DATA_PROVIDER=mock
RENTCAST_API_KEY=

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info
