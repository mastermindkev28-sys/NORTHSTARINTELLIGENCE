{
  "name": "@northstar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema, migrations, tenant-scoped data access, and RLS tests.",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": { "pg": "8.16.3" },
  "devDependencies": { "@types/pg": "8.15.5", "tsx": "4.20.6" }
}
